# Build output and loader cache both contain my actual watch data. The cache lives
# under the source root, so an unanchored pattern would miss it.
dist/
src/.observablehq/

# Naming who I would rather not be seen watching is itself personal.
# Unanchored, so it keeps working wherever the file moves.
blocked.txt

node_modules/
.venv/
__pycache__/
*.py[cod]

.direnv/
.pre-commit-config.yaml
.DS_Store
